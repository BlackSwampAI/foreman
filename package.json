{
  "name": "foreman",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24" },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:ui": "vite ui --host 127.0.0.1",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p ui/tsconfig.json",
    "test": "vitest run",
    "test:bridge": "tsc -p tsconfig.build.json && node investigations/local-cli-uhp/test.mjs",
    "build": "tsc -p tsconfig.build.json && vite build ui --outDir ../dist/ui --emptyOutDir",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
}
