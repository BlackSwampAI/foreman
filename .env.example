FOREMAN_HOST=127.0.0.1
FOREMAN_PORT=4399
FOREMAN_DATA_DIR=.foreman-data
# Worker turns time out after 600 s (max 900 s); Reviewer and other non-Planner/Orchestrator
# roles after 180 s (max 900 s). Planner and Orchestrator are fixed at 300 s (not configurable).
FOREMAN_TASK_TIMEOUT_MS=180000
FOREMAN_WORKER_TIMEOUT_MS=600000
# Initial HTTP request timeout (connection establishment only; does not limit turn duration).
FOREMAN_REQUEST_TIMEOUT_MS=120000
# Point this at the separately started local CLI bridge. Start instructions and
# its host-sign-in environment are in docs/three-harness-workflow.md.
UHP_BASE_URL=http://127.0.0.1:8787
UHP_HARNESS_ID=
UHP_MODEL=
UHP_TOKEN=
HINDSIGHT_BASE_URL=http://127.0.0.1:8888
HINDSIGHT_TOKEN=
# For a verified live Worker run, set this to the disposable Git repository
# configured as LOCAL_CLI_UHP_SOURCE_REPO in the bridge process.
FOREMAN_WORKSPACE_SOURCE_REPO=
FOREMAN_WORKSPACE_BRIDGE_URL=
FOREMAN_WORKSPACE_ALLOWED_SCOPE=
# JSON argv list; commands are run by Foreman in a disposable validation
# workspace. A workspace workflow requires a source repo, bridge URL, allowed
# scope, and at least one configured command together. Commands run without
# network access unless they set "network": true (true or false only), for
# example [{"name":"Install","command":"pnpm","args":["install","--frozen-lockfile"],"network":true}].
# Without the field, a pnpm/npm/yarn install (install, i, ci, add, or bare yarn) gets the
# network and every other command does not.
FOREMAN_VALIDATION_COMMANDS=[]
FOREMAN_VALIDATION_TIMEOUT_MS=120000
FOREMAN_VALIDATION_MAX_OUTPUT_BYTES=1048576
# Every validation command runs inside a bubblewrap (bwrap) sandbox that hides your home
# directory, credentials, Foreman's data dir, the source checkout, /tmp and /run. Validation
# fails if bwrap is missing. Set none only on hosts without bubblewrap (for example macOS);
# it runs Worker-authored code directly as you, with your credentials.
FOREMAN_VALIDATION_SANDBOX=bwrap
# Comma-separated absolute paths mounted read-only in the sandbox, for toolchains that live
# under a hidden directory and are not found automatically (for example $HOME/.volta).
FOREMAN_VALIDATION_SANDBOX_RO_PATHS=
