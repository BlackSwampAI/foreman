FOREMAN_HOST=127.0.0.1
FOREMAN_PORT=4399
FOREMAN_DATA_DIR=.foreman-data
# CLI role turns may run for up to two minutes before Foreman times out.
FOREMAN_REQUEST_TIMEOUT_MS=120000
# Point this at the separately started local CLI bridge. Start instructions and
# its host-sign-in environment are in docs/three-harness-workflow.md.
UHP_BASE_URL=http://127.0.0.1:8787
UHP_HARNESS_ID=
UHP_MODEL=
UHP_TOKEN=
HINDSIGHT_BASE_URL=http://127.0.0.1:8888
HINDSIGHT_TOKEN=
# For a verified live Worker run, set this to the disposable Git repository
# configured as LOCAL_CLI_UHP_SOURCE_REPO in the bridge process.
FOREMAN_WORKSPACE_SOURCE_REPO=
FOREMAN_WORKSPACE_BRIDGE_URL=
FOREMAN_WORKSPACE_ALLOWED_SCOPE=
# JSON argv list; commands are run by Foreman in a disposable validation
# workspace. A workspace workflow requires a source repo, bridge URL, allowed
# scope, and at least one configured command together.
FOREMAN_VALIDATION_COMMANDS=[]
FOREMAN_VALIDATION_TIMEOUT_MS=120000
FOREMAN_VALIDATION_MAX_OUTPUT_BYTES=1048576
